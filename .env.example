# Copy to .env and fill in, or set these in your host's dashboard.
# Every one of them is optional -- the site runs with none of them set, and
# prints sign-in links to the log instead of emailing them.

# Where the database file lives. On Render this must be the disk mount path.
DATA_DIR=/var/data

# Signs the login cookie. Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
# If you leave it unset, one is generated and stored in the database.
SECRET_KEY=

# Send real sign-in emails. Options: console (default), resend, smtp
MAIL_PROVIDER=resend
MAIL_FROM=Valentine Cookbook <cookbook@valentinecookbook.com>
RESEND_API_KEY=

# ...or use any SMTP server instead of Resend
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Comma separated. These people can edit or remove anything on the site.
# Set the real value in your host's dashboard, not in a file in the repository.
ADMIN_EMAILS=you@example.com

# Set to 1 once the site is on https so the login cookie is https-only.
FORCE_HTTPS=1

SITE_NAME=Valentine Cookbook

# Optional extra moderation layer using Claude. Off unless both are set.
# MODERATION_AI=1
# ANTHROPIC_API_KEY=
